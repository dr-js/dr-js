{
  "private": true,
  "name": "dr-js",
  "version": "0.26.0-pre",
  "description": "A collection of strange functions",
  "author": "dr-js",
  "license": "MIT",
  "repository": "github:dr-js/dr-js",
  "type": "module",
  "bin": {
    "dr-js": "bin/index.js",
    "DR": "bin/index.js"
  },
  "browser": "library/Dr.browser.js",
  "scripts": {
    "// repo ========================": "",
    "version-bump": "dr-dev --version-bump-git-branch --git-commit --debug",
    "tag-push": "dr-dev --version-bump-push-check --git-commit",
    "// script ======================": "",
    "script-pack": "node ./script/pack quiet pack",
    "script-pack-test": "node ./script/pack verbose pack test",
    "script-publish": "dr-dev --EE TEST_SANITY=true -E -- node ./script/pack pack publish",
    "script-generate-spec": "node ./script/generateSpec",
    "// build =======================": "",
    "// test ========================": "",
    "test-T": "dr-dev --EE '_DEV_=1&TEST_SANITY=true' -E -- dr-dev -T",
    "test-dev": "npm run test-T -- source/node/module/Software/docker.test.js",
    "test-source": "dr-dev -T source/env/ source/common/ source/node/ --TFS .test.js",
    "test-source-bin": "dr-dev -T source-bin/ --TFS .test.js",
    "test-output-library": "dr-dev -T output-gitignore/library/env/ output-gitignore/library/common/ output-gitignore/library/node/ --TFS .test.js",
    "test-output-module": "dr-dev -T output-gitignore/module/env/ output-gitignore/module/common/ output-gitignore/module/node/ --TFS .test.js",
    "test-output-bin": "dr-dev -T output-gitignore/bin/ --TFS .test.js",
    "test-browser": "node ./script/testBrowser production",
    "test-browser-dev": "node ./script/testBrowser development",
    "test-bin": "node ./script/testBin",
    "// =============================": "",
    "test": "dr-dev --EE TEST_SANITY=true -E -- npm run script-pack-test",
    "pptr-install": "npx @puppeteer/browsers install chrome-headless-shell --path ./.pptr-gitignore/",
    "pptr-list": "npx @puppeteer/browsers list --path ./.pptr-gitignore/",
    "// tooling ===============": "",
    "check-all": "npm run lint && npm run type-check",
    "lint": "oxlint",
    "type-check": "tsc",
    "// =======================": "",
    "prepack": "echo \"Error: pack with script-*\" && exit 1"
  },
  "engines": {
    "node": ">=24.18",
    "npm": ">=11.10"
  },
  "devDependencies": {
    "@min-pack/qjs": "^0.0.1",
    "@types/node": "^24.13.3",
    "oxlint": "^1.80.0",
    "puppeteer-core": "^25.9.0",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}
